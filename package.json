{
  "name": "@maheshwarimrinal/react-native-agents",
  "version": "1.3.0",
  "description": "24 expert React Native agents — upgrades and New Architecture migration, debugging, performance, security, offline sync, navigation and deep linking, push notifications, permissions, iOS/Android parity, state management, accessibility, testing, native modules, observability, release, store submission, dependency choices, codebase onboarding, in-app purchases, background execution, and monorepo setup — plus a deterministic bundle-size analyzer. Portable across Claude Code, Cursor, Windsurf, Copilot, Codex, MCP clients, and GitHub Actions.",
  "type": "module",
  "bin": {
    "react-native-agents": "./scripts/cli.mjs",
    "rn-agents": "./scripts/cli.mjs",
    "rn-agents-mcp": "./mcp-server/index.mjs"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node scripts/build.mjs --check",
    "test": "node scripts/test.mjs && node action/test.mjs && node evals/run.mjs --validate",
    "test:agents": "node scripts/test.mjs",
    "test:action": "node action/test.mjs",
    "install-agents": "node scripts/cli.mjs install",
    "mcp": "node mcp-server/index.mjs",
    "audit": "node action/index.mjs",
    "version": "node scripts/build.mjs && git add dist",
    "prepublishOnly": "node scripts/build.mjs --check && node scripts/test.mjs && node action/test.mjs && node evals/run.mjs --validate",
    "evals": "node evals/run.mjs",
    "evals:validate": "node evals/run.mjs --validate",
    "freshness": "node scripts/freshness.mjs"
  },
  "files": [
    "agents",
    "TELEMETRY.md",
    "shared",
    "scripts",
    "mcp-server",
    "action",
    "action.yml",
    "dist",
    "README.md",
    "LICENSE",
    "evals",
    "knowledge.json",
    "SECURITY.md",
    "!**/.fuse_hidden*",
    "!**/*.tgz",
    "!**/.DS_Store",
    "!evals/results.json"
  ],
  "keywords": [
    "react-native",
    "expo",
    "ai-agents",
    "claude-code",
    "cursor",
    "windsurf",
    "copilot",
    "mcp",
    "mcp-server",
    "performance",
    "security",
    "accessibility",
    "code-review",
    "vibe-coding",
    "bundle-size",
    "turbomodules",
    "build-errors",
    "observability",
    "crash-reporting",
    "monitoring",
    "react-native-upgrade",
    "new-architecture",
    "fabric",
    "debugging",
    "dependencies",
    "react-navigation",
    "deep-linking",
    "offline-first",
    "push-notifications",
    "permissions",
    "state-management",
    "platform-parity",
    "app-store-review",
    "onboarding",
    "github-action",
    "in-app-purchase",
    "storekit",
    "play-billing",
    "subscriptions",
    "background-tasks",
    "headless-js",
    "monorepo",
    "metro",
    "turborepo"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {},
  "publishConfig": {
    "access": "public"
  },
  "author": "Mrinal Maheshwari (https://github.com/maheshwarimrinal)",
  "homepage": "https://www.mrinalmaheshwari.com/projects/react-native-agents",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maheshwarimrinal/react-native-agents.git"
  },
